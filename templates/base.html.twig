<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>

		{% block stylesheets %}
			<link rel="stylesheet" href="{{ asset('css/aa.css') }}">
		{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body>
		<header class="header-fixed">
			<nav class="nav-container">
				<div class="logo">
					<a href="{{ path('app_home') }}">Notre Bibliothèque</a>
				</div>
				<ul class="nav-menu">
					<li>
						<a href="{{ path('app_book_index') }}">Livres</a>
					</li>
					{% if is_granted('ROLE_ADMIN') %}
						<li>
							<a href="{{ path('app_user_index') }}">Utilisateurs</a>
						</li>
					{% endif %}
					<li>
						<a href="{{ path('app_reservation_index') }}">Réservations</a>
					</li>
					<li>
						<a href="{{ path('app_login') }}">Login</a>
					</li>
					<li>
						<a href="{{ path('app_logout') }}">Logout</a>
					</li>
				</ul>
				<div class="user-info">
					{% if app.user %}
						{{ app.user.email }}
						est connecté(e)
					{% else %}
						Visiteur
					{% endif %}
				</div>
			</nav>
		</header>

		<main class="main-content"> {% block body %}{% endblock %}
			</main>

            <footer class="site-footer">
    <div class="footer-content">
        <p>
            © {{ "now"|date("Y") }} — Tous droits réservés
        </p>

        <p>
            Mentions légales
        </p>

        <p class="footer-authors">
            Site réalisé en groupe par
            <strong>Yohann.R</strong>,
            <strong>Thierry.R</strong>
            et <strong>Julien.B</strong>
        </p>
    </div>
</footer>
		</body>
	</html>
