{% extends 'base.html.twig' %}

{% block title %}Reservation{% endblock %}

{% block body %}
    <h1>Reservation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ reservation.id }}</td>
            </tr>
            <tr>
                <th>DateReservation</th>
                <td>{{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>DateReturn</th>
                <td>{{ reservation.dateReturn ? reservation.dateReturn|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ reservation.status }}</td>
            </tr>
            <tr>
                <th>Livre emprunter</th>
                <td>{{ reservation.book.title }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn btn-back" href="{{ path('app_reservation_index') }}">back to list</a>

    <a class="btn btn-edit"  href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">edit</a>

    {{ include('reservation/_delete_form.html.twig', { 'button_class': 'btn btn-delete' }) }}
{% endblock %}
