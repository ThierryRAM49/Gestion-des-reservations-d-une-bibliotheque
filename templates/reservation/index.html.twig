{% extends 'base.html.twig' %}

{% block title %}Reservation index{% endblock %}

{% block body %}
    <h1>Reservation index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DateReservation</th>
                <th>DateReturn</th>
                <th>Status</th>
                <th>Livre emprunter</th>
                <th>Emprunteur</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.id }}</td>
                <td>{{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d') : '' }}</td>
                <td>{{ reservation.dateReturn ? reservation.dateReturn|date('Y-m-d') : '' }}</td>
                <td>{{ reservation.status }}</td>
                <td>{{ reservation.book.title }}</td>
                <td>{{ reservation.user.email }}</td>
                <td>
                    <a class="btn btn-show" href="{{ path('app_reservation_show', {'id': reservation.id}) }}">show</a>
                    <a class="btn btn-reserve" href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-create" href="{{ path('app_reservation_new') }}">Create new</a>
{% endblock %}
