{% extends 'base.html.twig' %}

{% block title %}Edit Book{% endblock %}

{% block body %}
<div class="login-form">
    <h1 class="form-title">Edit Book</h1>

    {{ form_errors(bookForm) }}

    {{ form_start(bookForm) }}

    <!-- Titre -->
    <label for="book_title" class="form-label">Title</label>
    {{ form_widget(bookForm.title, { 'attr': { 'class': 'form-input' } }) }}

    <!-- Auteur -->
    <label for="book_autor" class="form-label">Author</label>
    {{ form_widget(bookForm.autor, { 'attr': { 'class': 'form-input' } }) }}

    <!-- Description -->
    <label for="book_description" class="form-label">Description</label>
    {{ form_widget(bookForm.description, { 'attr': { 'class': 'form-input', 'rows': 4 } }) }}

    <!-- Stock -->
    <label for="book_stock" class="form-label">Stock</label>
    {{ form_widget(bookForm.stock, { 'attr': { 'class': 'form-input' } }) }}

    <!-- Bouton Update -->
    <button type="submit" class="btn-submit">Update</button>

    {{ form_end(bookForm) }}

    <!-- Lien retour -->
    <div style="margin-top: 15px; text-align: center;">
        <a href="{{ path('app_book_index') }}">Back to list</a>
    </div>

    {{ include('book/_delete_form.html.twig') }}
</div>
{% endblock %}
