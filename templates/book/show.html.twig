{% extends 'base.html.twig' %}

{% block title %}Book
{% endblock %}

{% block body %}
	<h1>Book</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ book.id }}</td>
			</tr>
			<tr>
				<th>Title</th>
				<td>{{ book.title }}</td>
			</tr>
			<tr>
				<th>Autor</th>
				<td>{{ book.autor }}</td>
			</tr>
			<tr>
				<th>Description</th>
				<td>{{ book.description }}</td>
			</tr>
			<tr>
				<th>Stock</th>
				<td>{{ book.stock }}</td>
			</tr>
		</tbody>
	</table>

	<div class="book-actions">
    <a class="btn btn-back" href="{{ path('app_book_index') }}">Retour à la liste</a>

    {% if is_granted('ROLE_ADMIN') %}
        <a class="btn btn-edit" href="{{ path('app_book_edit', {'id': book.id}) }}">Modifier</a>

        {{ include('book/_delete_form.html.twig', { 'button_class': 'btn btn-delete' }) }}
    {% endif %}
</div>
{% endblock %}
